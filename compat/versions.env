# The upstream versions lean-home is written and checked against. The one place they are set:
# compat/*.sh and the Compat workflow source this file, and a test checks HA_VERSION in main.rs.
# Changing one is an upgrade; follow docs/compatibility.md.

# HA Core: the API, storage formats and behaviour we match, and the image the fixtures are
# recorded with. It also decides the frontend, PyYAML, annotatedyaml and tzdata versions below.
HA_VERSION=2026.11.3
HA_IMAGE=ghcr.io/home-assistant/home-assistant:2026.11.3
# The home-assistant-frontend package bundled in that HA image (CI serves it to lean-home).
HA_FRONTEND=20261028.6
# The broker the MQTT scenarios run on; was the floating `2` tag (same digest) when recorded.
MOSQUITTO_IMAGE=eclipse-mosquitto:2.1.4-alpine
